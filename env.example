# Example environment variables for TravelGuide (Node.js / Express)
# Copy this file to .env and fill in real values. Never commit .env itself.

# Weather provider: openweathermap or weatherapi
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=your_openweather_api_key

# Which LLM backend to use: gemini or anthropic
# Defaults to gemini automatically if GEMINI_API_KEY is set below.
LLM_PROVIDER=gemini

# --- Gemini (free tier) ---
# Get a key at https://aistudio.google.com/apikey - no billing required.
GEMINI_API_KEY=your_gemini_api_key
# Check https://ai.google.dev/gemini-api/docs/models for current free-tier models.
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic / Claude (paid, small starter credit only) ---
# CLAUDE_API_KEY=your_anthropic_key
# Check https://docs.claude.com/en/docs/about-claude/models before setting this.
# LLM_MODEL=claude-sonnet-5
# Optional: point at a different Anthropic-compatible endpoint instead
# LLM_API_URL=https://your-llm-endpoint.example/v1/messages
# LLM_API_KEY=your_llm_key

# Optional settings
# PORT=3000
